{
  "light": {
    "color": {
      "ground": { "$type": "color", "$value": "#f8f9fb", "$description": "Page background." },
      "surface": { "$type": "color", "$value": "#ffffff", "$description": "Card / panel fill." },
      "raised": {
        "$type": "color",
        "$value": "#f1f3f5",
        "$description": "Hover state, nav active background."
      },
      "border": { "$type": "color", "$value": "#e5e7eb" },
      "rule": {
        "$type": "color",
        "$value": "#eef0f2",
        "$description": "Row dividers inside panels."
      },
      "control": {
        "$type": "color",
        "$value": "#d6d9dd",
        "$description": "Input / dashed-button borders."
      },
      "text": {
        "$type": "color",
        "$value": "#101114",
        "$description": "Primary ink. Also the fill colour for the inverted primary button."
      },
      "muted": { "$type": "color", "$value": "#5f6368" },
      "faint": {
        "$type": "color",
        "$value": "#7a7d82",
        "$description": "Declared for parity with the dark theme; not referenced by any rule in the source file."
      },
      "accent": {
        "$type": "color",
        "$value": "#1d5fd6",
        "$description": "Deliberately hemat (spent sparingly): status dot, link underline, active nav icon/background. Never a button or card fill — that decision came out of resolving a tension between a pastel-heavy light pick and a row-based 'tidy' structural preference; filling surfaces with it was explicitly rejected."
      },
      "accentInk": {
        "$type": "color",
        "$value": "#0d3a86",
        "$description": "Reserved for text set on an accent-tinted background; not used by any rule in the current source file."
      },
      "positive": { "$type": "color", "$value": "#247b50" },
      "negative": { "$type": "color", "$value": "#c4242a" },
      "warning": {
        "$type": "color",
        "$value": "#92400e",
        "$description": "Declared in the source but not yet consumed by any component."
      },
      "pillNeutralBg": { "$type": "color", "$value": "#eef0f2" },
      "pillNeutralInk": { "$type": "color", "$value": "#3d3f42" }
    },
    "radius": {
      "card": { "$type": "dimension", "$value": "8px" },
      "control": { "$type": "dimension", "$value": "6px" }
    },
    "dimension": {
      "railWidth": {
        "$type": "dimension",
        "$value": "56px",
        "$description": "Icon-rail nav width at desktop widths (>=900px)."
      },
      "controlHeight": { "$type": "dimension", "$value": "34px" }
    },
    "spacing": {
      "gap": { "$type": "dimension", "$value": "20px" },
      "pad": { "$type": "dimension", "$value": "28px" }
    },
    "fontSize": {
      "title": { "$type": "dimension", "$value": "20px" },
      "section": { "$type": "dimension", "$value": "16px" },
      "body": { "$type": "dimension", "$value": "14px" },
      "small": { "$type": "dimension", "$value": "12px" }
    },
    "fontFamily": {
      "base": {
        "$type": "fontFamily",
        "$value": ["Public Sans", "Inter", "system-ui", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["IBM Plex Mono", "ui-monospace", "monospace"],
        "$description": "Numeric/date/ID values only, never running text."
      }
    }
  },
  "dark": {
    "color": {
      "ground": { "$type": "color", "$value": "#17181a" },
      "surface": { "$type": "color", "$value": "#131316" },
      "raised": { "$type": "color", "$value": "#212225" },
      "border": { "$type": "color", "$value": "#242528" },
      "rule": { "$type": "color", "$value": "#1c1d20" },
      "control": { "$type": "color", "$value": "#3a3b3e" },
      "text": {
        "$type": "color",
        "$value": "#f5f5f6",
        "$description": "Also the fill colour for the inverted primary button (near-white, matching the light theme's near-black inversion)."
      },
      "muted": { "$type": "color", "$value": "#9a9ca1" },
      "faint": { "$type": "color", "$value": "#7d7f84" },
      "accent": {
        "$type": "color",
        "$value": "#5b9bdb",
        "$description": "Same hue family as the light theme's accent, lightened for contrast on a dark ground. Kept hemat for the same reason — small marks only."
      },
      "accentInk": { "$type": "color", "$value": "#bcdcff" },
      "positive": { "$type": "color", "$value": "#4caf7d" },
      "negative": { "$type": "color", "$value": "#e5566f" },
      "warning": { "$type": "color", "$value": "#d9a441" },
      "pillNeutralBg": { "$type": "color", "$value": "#212225" },
      "pillNeutralInk": { "$type": "color", "$value": "#c7c8cb" }
    },
    "radius": {
      "card": { "$type": "dimension", "$value": "8px" },
      "control": { "$type": "dimension", "$value": "6px" }
    },
    "dimension": {
      "railWidth": { "$type": "dimension", "$value": "56px" },
      "controlHeight": { "$type": "dimension", "$value": "34px" }
    },
    "spacing": {
      "gap": { "$type": "dimension", "$value": "20px" },
      "pad": { "$type": "dimension", "$value": "28px" }
    },
    "fontSize": {
      "title": { "$type": "dimension", "$value": "20px" },
      "section": { "$type": "dimension", "$value": "16px" },
      "body": { "$type": "dimension", "$value": "14px" },
      "small": { "$type": "dimension", "$value": "12px" }
    },
    "fontFamily": {
      "base": {
        "$type": "fontFamily",
        "$value": ["Public Sans", "Inter", "system-ui", "sans-serif"]
      },
      "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
    }
  }
}
