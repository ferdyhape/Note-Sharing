# Copy to .env and fill in. See docs/CHECKLIST.md Phase 0 for where each value comes from.

# Neon Postgres — DATABASE_URL is the pooled connection (app runtime),
# DIRECT_URL is the unpooled one (migrations only). Neon's own dashboard
# names these the other way around — see the note in prisma.config.ts.
DATABASE_URL=
DIRECT_URL=

# Upstash Redis — REST API credentials, from the database's dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push (VAPID). Generate with: node -e "..." (see docs/adr/0007-technology-stack.md)
# or re-run the one-off script used to generate the pair originally.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Auth.js
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
